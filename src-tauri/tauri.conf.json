{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamScope",
  "version": "0.1.1",
  "identifier": "com.thangvv4.streamscope",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreamScope",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast native client for Kafka and streaming systems",
    "longDescription": "StreamScope is a fast, native desktop client for Apache Kafka — browse topics, tail and inspect messages with JSON and Avro decoding, produce and replay, and check consumer lag. Local-first, no cloud account required.",
    "copyright": "© 2025 StreamScope",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
